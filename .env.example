# Copy to .env and fill real values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

DB_ENGINE=mysql
DB_NAME=shms_db
DB_USER=shms_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# LLM / AI assistant (Phase 8). Keys stay in .env — never in JS or git.
# Leave empty to use grounded manual-excerpt answers (no external calls).
# Set LLM_API_KEY + LLM_MODEL to enable generative answers via an
# OpenAI-compatible API (LLM_BASE_URL, e.g. https://api.openai.com/v1).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
EMBEDDING_MODEL=tfidf-local

# AI cost control: max assistant answers per user per calendar hour.
CHAT_ASK_PER_HOUR=30

# ---- Production only (config.settings_production) ----
# DJANGO_DEBUG must stay False; DJANGO_ALLOWED_HOSTS must list real hosts (no *).
# DJANGO_CSRF_TRUSTED=https://hospital.example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# REDIS_URL=redis://127.0.0.1:6379/0
# LOG_LEVEL=INFO
