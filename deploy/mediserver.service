[Unit]
Description=MediServe Django App
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/mediserver
Environment="DJANGO_SETTINGS_MODULE=config.settings_production"
EnvironmentFile=/opt/mediserver/.env
ExecStart=/opt/mediserver/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
